# Twi Speech Training Engine Environment Variables
# Copy this file to .env and fill in your actual values

# MongoDB Configuration
# Connection URI for MongoDB (supports MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/
# Or for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net

# Cloudflare R2 Storage Configuration
# Your R2 bucket name
R2_BUCKET_NAME=twi-speech-data

# R2 Access credentials
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here

# R2 Endpoint URL
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# Optional: Development Settings
# Set to true to use dummy data instead of real database
USE_DUMMY_DATA=false

# Set to true to enable debug logging
DEBUG=false

# Optional: Model Configuration
# Override default model type (wav2vec2, whisper, etc.)
MODEL_TYPE=wav2vec2

# Override default pretrained model
PRETRAINED_MODEL=facebook/wav2vec2-base

# Optional: Training Configuration
# Override default batch size
BATCH_SIZE=8

# Override default learning rate
LEARNING_RATE=0.0001

# Override default number of epochs
NUM_EPOCHS=10

# Optional: Audio Configuration
# Override default sample rate
AUDIO_SAMPLE_RATE=16000

# Optional: Paths
# Override default directories
RECORDINGS_DIR=data/recordings
CACHE_DIR=data/cache
MODELS_DIR=models/superior
FEATURES_DIR=data/processed_superior

# Optional: API Keys for external services
# Weights & Biases for experiment tracking
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=twi-speech
WANDB_ENTITY=your_wandb_entity

# HuggingFace Hub (for model downloads/uploads)
HUGGINGFACE_TOKEN=your_huggingface_token_here

# Optional: Hardware Configuration
# Force specific device (cuda, cpu, auto)
DEVICE=auto

# Enable mixed precision training
MIXED_PRECISION=true

# Number of worker processes for data loading
NUM_WORKERS=4

# Optional: Logging Configuration
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable file logging
LOG_TO_FILE=true
LOG_FILE_PATH=logs/training.log
