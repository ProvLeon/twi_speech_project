# Twi Speech Recognition Training Engine - Environment Variables
# Copy this file to .env and update with your actual values

# =============================================================================
# DATABASE CONFIGURATION (Required)
# =============================================================================

# MongoDB Connection - Replace with your actual MongoDB URI
MONGODB_URI=mongodb://localhost:27017
MONGO_DB_NAME=twi_speech_data

# =============================================================================
# CLOUDFLARE R2 STORAGE CONFIGURATION (Required)
# =============================================================================

# Cloudflare R2 Storage - Get these from your Cloudflare Dashboard
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_ACCESS_KEY_ID=your_r2_access_key_here
CLOUDFLARE_SECRET_ACCESS_KEY=your_r2_secret_key_here
R2_BUCKET_NAME=twi-speech-data
R2_ENDPOINT_URL=https://your_cloudflare_account_id_here.r2.cloudflarestorage.com

# =============================================================================
# EXPERIMENT TRACKING (Optional but Recommended)
# =============================================================================

# Weights & Biases - Get from https://wandb.ai/settings
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=twi-speech-recognition
WANDB_ENTITY=your_wandb_username_here

# =============================================================================
# HUGGING FACE (Optional but Recommended)
# =============================================================================

# Hugging Face Hub Token - Get from https://huggingface.co/settings/tokens
HUGGINGFACE_HUB_TOKEN=your_huggingface_token_here

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================

# CPU/GPU Configuration
CUDA_VISIBLE_DEVICES=0
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
NUMEXPR_NUM_THREADS=4

# PyTorch Performance
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# =============================================================================
# PATHS CONFIGURATION (Optional - uses defaults if not set)
# =============================================================================

# Data Directories
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
CACHE_DIR=./data/cache

# Model Directories
MODEL_DIR=./models
CHECKPOINT_DIR=./experiments/checkpoints
PRETRAINED_DIR=./models/pretrained

# Experiment Directories
EXPERIMENT_DIR=./experiments/runs
LOG_DIR=./logs
TENSORBOARD_DIR=./experiments/tensorboard
WANDB_DIR=./experiments/wandb

# Output Directories
OUTPUT_DIR=./experiments/outputs
EVALUATION_DIR=./experiments/evaluation

# Temporary Directory
TEMP_DIR=./temp

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Environment Type
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Development Flags
USE_SAMPLE_DATA=false
SAMPLE_DATA_SIZE=100

# =============================================================================
# LANGUAGE SPECIFIC SETTINGS
# =============================================================================

# Twi Language Configuration
DEFAULT_DIALECT=Asante
SUPPORTED_DIALECTS=Asante,Akuapem,Fante
ENABLE_CODE_SWITCHING=true
ENABLE_TONE_PROCESSING=true

# Audio Processing
DEFAULT_SAMPLE_RATE=16000
MAX_AUDIO_LENGTH=30.0
MIN_AUDIO_LENGTH=0.5

# Training Targets
TARGET_WER=0.30
TARGET_CER=0.20
TARGET_BLEU=0.70

# =============================================================================
# SECURITY (Optional)
# =============================================================================

# Random seed for reproducibility
RANDOM_SEED=42

# JWT Configuration (if using authentication)
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================

# OpenAI API (for comparison/evaluation)
OPENAI_API_KEY=your_openai_api_key_here

# Slack Notifications (optional)
SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# Email Alerts (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
ALERT_EMAIL_RECIPIENTS=admin@yourcompany.com

# =============================================================================
# CLOUD PROVIDERS (Optional)
# =============================================================================

# AWS Configuration (if using AWS services)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=twi-speech-aws-backup

# Google Cloud Configuration (if using GCP)
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
GCP_PROJECT_ID=your_gcp_project_id
GCS_BUCKET=twi-speech-gcp-backup

# =============================================================================
# INSTRUCTIONS
# =============================================================================

# 1. Copy this file to .env: cp .env.example .env
# 2. Replace all "your_*_here" placeholders with actual values
# 3. At minimum, you MUST set:
#    - MONGODB_URI (database connection)
#    - CLOUDFLARE_ACCOUNT_ID (R2 storage)
#    - CLOUDFLARE_ACCESS_KEY_ID (R2 storage)
#    - CLOUDFLARE_SECRET_ACCESS_KEY (R2 storage)
#    - R2_BUCKET_NAME (R2 storage)
# 4. Recommended to set:
#    - WANDB_API_KEY (experiment tracking)
#    - HUGGINGFACE_HUB_TOKEN (model access)
# 5. Never commit .env files to version control
# 6. Use strong, unique passwords and rotate keys regularly

# =============================================================================
# GETTING CREDENTIALS
# =============================================================================

# MongoDB:
# - Local: Use mongodb://localhost:27017
# - Atlas: Get URI from MongoDB Atlas dashboard

# Cloudflare R2:
# - Go to Cloudflare Dashboard → R2 Object Storage
# - Create API token with R2:Edit permissions
# - Get Account ID from the dashboard

# Weights & Biases:
# - Sign up at wandb.ai
# - Go to https://wandb.ai/settings
# - Copy your API key

# Hugging Face:
# - Sign up at huggingface.co
# - Go to https://huggingface.co/settings/tokens
# - Create a "Read" token
